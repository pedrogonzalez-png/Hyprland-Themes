{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "  │  ",
    "color": {
      "title": "#FFDADE",
      "keys": "#D94F69",
      "output": "#F5E7EC",
      "separator": "#9D5C78"
    },
    "key": {
      "width": 12
    },
    "percent": {
      "type": 9,
      "color": {
        "green": "#CF4B67",
        "yellow": "#B0A2D6",
        "red": "#F59CAB"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "key": " ",
      "format": "{##F2A5B8}━━ HIYUKI ━━━━━━━━━━━━━━━━━━━━━{#}"
    },
    "title",
    "separator",
    {
      "type": "os",
      "key": "Sistema",
      "keyColor": "#D94F69"
    },
    {
      "type": "board",
      "key": "Placa-mae",
      "keyColor": "#F2A5B8"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#D94F69"
    },
    {
      "type": "uptime",
      "key": "Ligado",
      "keyColor": "#D94F69"
    },
    {
      "type": "packages",
      "key": "Pacotes",
      "keyColor": "#F2A5B8"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "#D94F69"
    },
    {
      "type": "display",
      "key": "Monitor",
      "keyColor": "#D94F69"
    },
    {
      "type": "wm",
      "key": "Desktop",
      "keyColor": "#F2A5B8"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "#D94F69"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#D94F69"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#F2A5B8"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "#D94F69"
    },
    {
      "type": "disk",
      "key": "Disco",
      "keyColor": "#D94F69"
    },
    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "{##D94F69}━━━{#}  {##F2A5B8}━━━{#}  {##B0A2D6}━━━{#}  {##FFDADE}━━━{#}"
    }
  ]
}
