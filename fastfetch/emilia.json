{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": null,
  "display": {
    "separator": "  │  ",
    "color": {
      "title": "#FFE4F4",
      "keys": "#CA82BC",
      "output": "#FAEDF8",
      "separator": "#A994C8"
    },
    "key": {
      "width": 12
    },
    "percent": {
      "type": 9,
      "color": {
        "green": "#BDA6E8",
        "yellow": "#F5BAD4",
        "red": "#F8D6EC"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "key": " ",
      "format": "{##BDA6E8}━━ EMILIA ━━━━━━━━━━━━━━━━━━━━━{#}"
    },
    "title",
    "separator",
    {
      "type": "os",
      "key": "Sistema",
      "keyColor": "#CA82BC"
    },
    {
      "type": "board",
      "key": "Placa-mae",
      "keyColor": "#BDA6E8"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "keyColor": "#CA82BC"
    },
    {
      "type": "uptime",
      "key": "Ligado",
      "keyColor": "#CA82BC"
    },
    {
      "type": "packages",
      "key": "Pacotes",
      "keyColor": "#BDA6E8"
    },
    {
      "type": "shell",
      "key": "Shell",
      "keyColor": "#CA82BC"
    },
    {
      "type": "display",
      "key": "Monitor",
      "keyColor": "#CA82BC"
    },
    {
      "type": "wm",
      "key": "Desktop",
      "keyColor": "#BDA6E8"
    },
    {
      "type": "terminal",
      "key": "Terminal",
      "keyColor": "#CA82BC"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "keyColor": "#CA82BC"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "keyColor": "#BDA6E8"
    },
    {
      "type": "memory",
      "key": "RAM",
      "keyColor": "#CA82BC"
    },
    {
      "type": "disk",
      "key": "Disco",
      "keyColor": "#CA82BC"
    },
    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "{##CA82BC}━━━{#}  {##BDA6E8}━━━{#}  {##F5BAD4}━━━{#}  {##FFE4F4}━━━{#}"
    }
  ]
}
