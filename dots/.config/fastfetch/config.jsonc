{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "auto",
    "padding": { "top": 1, "left": 1, "right": 2 }
  },

  "display": {
    "separator": "  ",
    "showErrors": false,
    "color": {
      "keys": "red",
      "title": "magenta"
    }
  },

  "modules": [
    "title",
    "separator",
    { "type": "os", "key": "Sistema" },
    { "type": "host", "key": "Placa-mae" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "uptime", "key": "Ligado" },
    { "type": "packages", "key": "Pacotes" },
    { "type": "shell", "key": "Shell" },
    {
      "type": "display",
      "key": "Monitor",
      "format": "{width}x{height} @ {refresh-rate} Hz"
    },
    { "type": "wm", "key": "Desktop" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "RAM" },
    {
      "type": "disk",
      "key": "Disco (/) ",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    "break",
    "colors"
  ]
}
